<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="GUI.ConfiguracoesController">
    <Label text="Configurações / Einstellungen" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <HBox spacing="10">
        <Label text="Idioma / Sprache:"/>
        <ComboBox fx:id="comboIdioma"/>
    </HBox>

    <HBox spacing="10">
        <Button fx:id="btnSalvar" text="Salvar / Speichern" onAction="#salvarConfiguracoes" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </HBox>
</VBox>
