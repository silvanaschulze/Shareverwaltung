<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="50" alignment="CENTER" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="GUI.MainController" stylesheets="@style.css">

    <!-- Título -->
    <Label text="Bem-vindo ao ShareVerwaltung | Willkommen bei ShareVerwaltung"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <!-- Botões alinhados verticalmente -->
    <VBox spacing="20" alignment="CENTER">
        <Button fx:id="btnInterne" text="Gerenciar Internos | Interne verwalten"
                onAction="#abrirTelaInternos" minWidth="250"/>

        <Button fx:id="btnExterne" text="Gerenciar Externos | Externe verwalten"
                onAction="#abrirTelaExternos" minWidth="250"/>

        <Button fx:id="btnKunden" text="Gerenciar Clientes | Kunden verwalten"
                onAction="#abrirTelaKunden" minWidth="250"/>

        <Button fx:id="btnConfiguracoes" text="Configurações | Einstellungen"
                onAction="#abrirTelaConfiguracoes" minWidth="250"/>
    </VBox>

    <!-- Rodapé com crédito -->

    <Label text="Projetado por Silvana Schulze | Entwickelt von Silvana Schulze"
           style="-fx-font-size: 12px; -fx-text-fill: black;"/>

</VBox>

